# Local development only. Copy to .env and replace every placeholder.
NYX_MAILBOX_ONION=<generated-v3-address>.onion
NYX_MAILBOX_PORT=443
NYX_LOCAL_MAILBOX_TOKEN_HEX=<64-random-hex-characters>
NYX_RECIPIENT_MAILBOX_TOKEN_HEX=<different-64-random-hex-characters>
NYX_MAILBOX_DATA_DIR=nyx-mailbox-data
NYX_DESKTOP_STATE_PATH=nyx-desktop-state.nyx
NYX_DELIVERY_QUEUE_PATH=nyx-delivery.sqlite3
